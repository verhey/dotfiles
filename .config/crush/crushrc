option attribution-trailer-style none
option attribution-generated-with false
option auto-summarize false
option metrics false
option ui transparent true
option global-context-path "$HOME/AGENTS.md"

permissions allow view ls glob grep pre-commit fetch agentic_fetch sourcegraph
permissions allow lsp_diagnostics lsp_definition lsp_references lsp_symbols lsp_call_hierarchy

lsp add go --command gopls --filetypes go --root-markers go.mod --root-markers go.work
lsp add terraform --command terraform-ls --args serve --filetypes terraform --filetypes tf

if [[ "$CRUSH_CWD" == "$HOME/code/fg/"* ]]; then
  mcp add notion --type http --url "https://mcp.notion.com/mcp" --oauth true
  mcp add datadog --type http --url "https://mcp.us5.datadoghq.com/v1/mcp" --oauth true
  mcp add shortcut --type http --url "https://mcp.shortcut.com/mcp" --oauth true
fi

hook add PreToolUse \
  --matcher '^(bash|view|edit|write|multiedit)$' \
  --command '"$HOME/.config/crush/hooks/command-policy.sh"' \
  --name command-policy
